generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TRAINER
}

enum BlockType {
  EXERCISE
  SUPERSET
  DROPSET
  REST_PAUSE
  BISET
  CIRCUIT
  REST
}

enum DayStatus {
  TRAINED
  MISSED
  CARDIO
  REST
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())
  emailVerifiedAt DateTime? // null = ainda não confirmou o e-mail (cadastro pelo app)

  studentProfile StudentProfile?
  trainerProfile TrainerProfile?
  authTokens     AuthToken[]
}

model TrainerProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  bio      String?
  brandName String?
  avatarUrl String?
  whatsapp  String?

  students        StudentProfile[]
  workouts        Workout[]
  weeklyPrograms  WeeklyProgram[]
  exercises       Exercise[]
  libraryContents LibraryContent[]
  plans           Plan[]
  products        Product[]
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id])

  goal         String?
  weightKg     Float?
  heightCm     Float?
  age          Int?
  level        String?
  avatarUrl    String?
  whatsapp     String?
  status       String   @default("active") // pending | active
  workoutDueAt DateTime? // consultoria: prazo para o professor liberar o treino

  assignments      WorkoutAssignment[]
  exerciseLogs     ExerciseLog[]
  progressEntries  ProgressEntry[]
  progressPhotos   ProgressPhoto[]
  calendarEntries  CalendarEntry[]
  subscriptions    Subscription[]
  workoutRatings   WorkoutRating[]
  purchases        Purchase[]
}

model Exercise {
  id             String   @id @default(cuid())
  trainerId      String
  trainer        TrainerProfile @relation(fields: [trainerId], references: [id])

  name           String
  videoUrl       String?
  gifUrl         String?
  description    String?
  correctForm    String?
  commonMistakes String?
  muscleGroup    String
  equipment      String?

  workoutExercises WorkoutExercise[]
  exerciseLogs     ExerciseLog[]
  blockExtraItems  BlockExercise[]
}

model Workout {
  id           String   @id @default(cuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id])

  name         String
  imageUrl     String?
  goal         String?
  estimatedMin Int?
  difficulty   String?
  isTemplate   Boolean  @default(false)

  blocks       WorkoutExercise[]
  assignments  WorkoutAssignment[]
  programDays  WeeklyProgramDay[]
  calendarEntries CalendarEntry[]
  ratings      WorkoutRating[]
}

model WorkoutExercise {
  id          String    @id @default(cuid())
  workoutId   String
  workout     Workout   @relation(fields: [workoutId], references: [id])
  exerciseId  String?
  exercise    Exercise? @relation(fields: [exerciseId], references: [id])

  order       Int
  type        BlockType @default(EXERCISE)
  sets        Int?
  reps        String?
  loadKg      Float?
  rpe         Int?
  restSeconds Int?
  notes       String?

  extraItems  BlockExercise[]
}

model BlockExercise {
  id         String @id @default(cuid())
  blockId    String
  block      WorkoutExercise @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int    @default(0)
}

model WeeklyProgram {
  id        String   @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id])

  name      String
  createdAt DateTime @default(now())

  days      WeeklyProgramDay[]
  productWeeks ProductWeek[]
}

model WeeklyProgramDay {
  id        String   @id @default(cuid())
  programId String
  program   WeeklyProgram @relation(fields: [programId], references: [id])
  weekday   Int      // 0=domingo ... 6=sábado
  workoutId String?
  workout   Workout? @relation(fields: [workoutId], references: [id])
}

model WorkoutAssignment {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id])

  weekday     Int?     // 0=domingo ... 6=sábado (mesma convenção do Date.getDay() do JS); null = sem dia fixo (modelo antigo)
  startedAt   DateTime @default(now())
  currentWeek Int      @default(1)
  currentDay  Int      @default(1)
  status      String   @default("active")
}

model ExerciseLog {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  date        DateTime @default(now())
  loadKg      Float
  reps        Int
  notes       String?
}

model ProgressEntry {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])

  date        DateTime @default(now())
  weightKg    Float?
  bodyFatPct  Float?
  measurements Json?
}

model ProgressPhoto {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])

  date        DateTime @default(now())
  tag         String
  url         String
}

model CalendarEntry {
  id          String    @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])

  date        DateTime
  status      DayStatus
  workoutId   String?
  workout     Workout?  @relation(fields: [workoutId], references: [id])
}

model LibraryContent {
  id          String   @id @default(cuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id])

  type        String
  category    String?
  title       String
  url         String
  requiredPlanId String?
}

model Plan {
  id           String   @id @default(cuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id])

  type         String
  billingType  String   @default("UNICA") // RECORRENTE | UNICA | INFLUENCER
  name         String
  priceCents   Int

  subscriptions Subscription[]
}

model Subscription {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id])

  priceCents  Int?
  status      String   @default("active")
  startedAt   DateTime @default(now())
  renewsAt    DateTime?    // usado em planos recorrentes
  periodDays  Int?         // consultoria: 30, 60, 90...
  purchaseDate DateTime?   // usado em compra única / parceria com influencer
}

model WorkoutRating {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id])

  rating    Int      // 1 a 5
  comment   String?
  createdAt DateTime @default(now())
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?
}

// ---------- Loja de planilhas ----------
// Uma planilha (ex: Glúteos 3D) é uma sequência de semanas; cada semana é um programa semanal.
model Product {
  id            String   @id @default(cuid())
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id])

  slug          String   @unique
  name          String
  category      String?  // ex: "Glúteos"
  tagline       String?
  description   String?
  priceCents    Int      @default(0)
  oldPriceCents Int?
  checkoutUrl   String?
  tictoCodes    String?  // códigos do produto/oferta na Ticto, separados por vírgula (ex: OA8E76744)
  unlockMode    String   @default("WEEKLY") // WEEKLY = uma semana a cada X dias | ALL_AFTER = tudo depois de X dias
  unlockDays    Int      @default(7)
  status        String   @default("draft") // draft | soon | published
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  weeks         ProductWeek[]
  purchases     Purchase[]
}

model ProductWeek {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  week      Int
  programId String
  program   WeeklyProgram @relation(fields: [programId], references: [id])

  @@unique([productId, week])
}

model Purchase {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  studentId   String?
  student     StudentProfile? @relation(fields: [studentId], references: [id])
  email       String
  status      String   @default("active") // active | refunded | canceled
  source      String   @default("ticto")  // ticto | manual
  externalId  String?  // código do pedido na Ticto
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([productId, email])
}

// Códigos de confirmação de e-mail e links para criar senha (convite, compra, esqueci a senha)
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String    // VERIFY_EMAIL | SET_PASSWORD
  tokenHash String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Cada aviso recebido da Ticto fica guardado para conferência no painel
model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  result    String   // processed | ignored | error
  message   String?
  payload   Json
  createdAt DateTime @default(now())
}

